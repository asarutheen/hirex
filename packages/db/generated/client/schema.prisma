generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(APPLICANT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications Application[]
  jobs         Job[]
  resumes      Resume[]
}

model Job {
  id          String                       @id @default(cuid())
  title       String
  description String
  location    String?
  salary      String?
  postedById  String
  embedding   Unsupported("vector(3072)")?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  postedBy     User          @relation(fields: [postedById], references: [id])
  applications Application[]
}

model Application {
  id          String            @id @default(uuid())
  applicant   User              @relation(fields: [applicantId], references: [id])
  applicantId String
  job         Job               @relation(fields: [jobId], references: [id])
  jobId       String
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([applicantId, jobId])
}

model Resume {
  id         String   @id @default(uuid())
  userId     String
  fileName   String
  fileKey    String // path in MinIO bucket
  fileUrl    String // accessible URL
  parsedText String? // extracted text from PDF — filled in Phase 3
  embedding  String? // we'll handle vector separately like jobs
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum Role {
  APPLICANT
  EMPLOYER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  SHORTLISTED
  REJECTED
}
